SPRING_APPLICATION_NAME=magic-hiring-exercise

SPRING_R2DBC_URL=r2dbc:postgresql://localhost:55432/magic
SPRING_R2DBC_USERNAME=magic
SPRING_R2DBC_PASSWORD=magic
SPRING_R2DBC_POOL_INITIAL_SIZE=5
SPRING_R2DBC_POOL_MAX_SIZE=20

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_URL=jdbc:postgresql://localhost:55432/magic
SPRING_FLYWAY_USER=magic
SPRING_FLYWAY_PASSWORD=magic
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

SPRING_GRAPHQL_GRAPHIQL_ENABLED=true
SPRING_GRAPHQL_GRAPHIQL_PATH=/graphiql
SPRING_GRAPHQL_SCHEMA_PRINTER_ENABLED=true
SPRING_GRAPHQL_PATH=/graphql

SPRING_AI_MODEL_CHAT=openai
OPENAI_API_KEY=replace-with-real-key
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o
SPRING_AI_OPENAI_CHAT_OPTIONS_TEMPERATURE=0.7

SERVER_PORT=8080
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_R2DBC_CORE=DEBUG
